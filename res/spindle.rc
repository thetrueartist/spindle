// Spindle - Windows resources.
// The icon must be the lowest-numbered ICON resource in the binary: Explorer
// and the shell pick an executable's display icon by lowest ordinal, not by
// which one the window class loads.

#include <windows.h>

#define IDI_APPICON 1

IDI_APPICON ICON "spindle.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,5,11,0
PRODUCTVERSION  2,5,11,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0"   // UK English, Unicode
        BEGIN
            VALUE "FileDescription", "Spindle - disk space, mapped"
            VALUE "FileVersion",     "2.5.11.0"
            VALUE "InternalName",    "spindle"
            VALUE "OriginalFilename","spindle.exe"
            VALUE "ProductName",     "Spindle"
            VALUE "ProductVersion",  "2.5.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END

// Common Controls v6 for the modern context menu and dialog styling, plus an
// explicit per-monitor DPI declaration. The runtime SetProcessDpiAwarenessContext
// call still runs first; this covers the case where that API is unavailable.
1 RT_MANIFEST "spindle.manifest"
